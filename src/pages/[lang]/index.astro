---
import SiteLayout from "../../layouts/SiteLayout.astro";
import HeroObserver from "../../components/HeroObserver.astro";
import Icon from "../../components/Icon.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import Contacts from "../../components/Contacts.astro";
import { site } from "../../config/site";
import { articlesFor } from "../../lib/articles";
import {
  locales,
  otherLocale,
  homePath,
  blogPath,
  text,
  type Locale,
} from "../../lib/i18n";
export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { lang: locale },
    props: { locale },
  }));
}
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const articles = await articlesFor(locale);
const t = (pl: string, en: string) => text(locale, pl, en);
---

<SiteLayout
  locale={locale}
  page="home"
  title={site.name}
  description={site.description[locale]}
  otherPath={homePath(otherLocale(locale))}
>
  <main id="main" class="wrap">
    <section class="hero" aria-labelledby="home-title">
      <HeroObserver />
      <span class="eyebrow">
        {t(
          "INTERNET JEST FAJNIEJSZY Z LUDŹMI",
          "THE INTERNET IS BETTER WITH PEOPLE",
        )}
      </span>
      <h1 id="home-title">
        {locale === "pl" ? (
          <>
            Ciekawość to
            <br />
            dobry <em>początek.</em>
          </>
        ) : (
          <>
            Curiosity is
            <br />a good <em>beginning.</em>
          </>
        )}
      </h1>
      <div class="hero-bio">
        <div>
          <p>{site.bio[locale]}</p>
        </div>
      </div>
      <a
        class="button button-primary"
        href={articles.length ? blogPath(locale) : "#contact"}
      >
        {articles.length
          ? t("Zobacz, co mi chodzi po głowie", "See what’s on my mind")
          : t("Złapmy kontakt", "Let’s connect")}
        <Icon />
      </a>
    </section>
    {articles.length > 0 && (
      <section class="latest" aria-labelledby="latest-title">
        <div class="section-heading">
          <div>
            <span class="eyebrow">
              {t("NAJNOWSZE ARTYKUŁY", "LATEST ARTICLES")}
            </span>
            <h2 id="latest-title">
              {t("O tym chciałem opowiedzieć.", "What I wanted to share.")}
            </h2>
          </div>
          <a class="all-articles" href={blogPath(locale)}>
            {t("Wszystkie artykuły", "All articles")}
            <Icon />
          </a>
        </div>
        <div class="article-cards">
          {articles.slice(0, 3).map((article) => (
            <ArticleCard article={article} locale={locale} />
          ))}
        </div>
      </section>
    )}
    <Contacts locale={locale} />
  </main>
</SiteLayout>
