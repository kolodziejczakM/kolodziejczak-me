---
import Seo from "../components/Seo.astro";
import { site } from "../config/site";
import Avatar from "../components/Avatar.astro";
import BackgroundSurface from "../components/BackgroundSurface.astro";
import { homePath } from "../lib/i18n";
import "../styles/site.css";

const destinations = { pl: homePath("pl"), en: homePath("en") };
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <style is:inline>
      html {
        color-scheme: dark;
        background: #0e241d;
      }
      body {
        margin: 0;
      }
    </style>
    <script is:inline define:vars={{ destinations }} data-language-redirect>
      // Keep this synchronous; the policy matches preferredLocale in lib/i18n.
      const language = navigator.languages?.[0] || navigator.language || "";
      const locale =
        language.toLowerCase().split("-")[0] === "pl" ? "pl" : "en";
      window.location.replace(
        destinations[locale] + window.location.search + window.location.hash,
      );
    </script>
    <Seo
      locale="pl"
      path="/"
      kind="language"
      title={site.name}
      description={site.description.pl}
      translations={{ pl: "/pl/", en: "/en/" }}
    />
    <meta name="theme-color" content="#0e241d" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <BackgroundSurface />
    <noscript>
      <main class="language-home">
        <Avatar locale="pl" />
        <h1>
          kolodziejczak<span class="brand-domain">.me</span>
        </h1>
        <p>Marcin Kołodziejczak</p>
        <p>Wybierz język / Choose a language</p>
        <div>
          <a class="button button-primary" href="/pl/" lang="pl">
            Polski
          </a>
          <a class="button button-secondary" href="/en/" lang="en">
            English
          </a>
        </div>
      </main>
    </noscript>
  </body>
</html>
