---
import { Picture } from "astro:assets";
import portrait from "../assets/profile/marcin-kolodziejczak.jpg";
import { text, type Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
---

<Picture
  src={portrait}
  class="avatar"
  alt={text(
    Astro.props.locale,
    "Portret Marcina Kołodziejczaka",
    "Portrait of Marcin Kołodziejczak",
  )}
  formats={["avif", "webp"]}
  fallbackFormat="jpg"
  width={128}
  height={128}
  widths={[96, 128, 192, 256, 384]}
  sizes="(max-width: 760px) 96px, 128px"
  quality={82}
  fit="cover"
  loading="eager"
  decoding="async"
/>
