---
interface Props {
  name?:
    | "arrow"
    | "read"
    | "spark"
    | "chat"
    | "copy"
    | "close"
    | "down"
    | "play"
    | "up"
    | "share";
  class?: string;
}
const { name = "arrow", class: className } = Astro.props;
const paths = {
  arrow: '<path d="M4 12h16m-6-6 6 6-6 6"/>',
  read: '<path d="M3 5q5-3 9 0 4-3 9 0v15q-5-3-9 0-4-3-9 0Z"/><path d="M12 5v15"/>',
  spark:
    '<circle cx="12" cy="12" r="4" fill="currentColor" stroke="none"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1 1m12 12 1 1M5 19l1-1M18 6l1-1"/>',
  chat: '<path d="M3 5h18v13H9l-6 3Z"/><path d="M7 9h10M7 13h6"/>',
  copy: '<rect x="8" y="8" width="13" height="13" rx="3"/><path d="M15 3H6Q3 3 3 6v9"/>',
  close: '<path d="m6 6 12 12M18 6 6 18"/>',
  down: '<path d="m6 9 6 6 6-6"/>',
  up: '<path d="M12 20V4m-7 7 7-7 7 7"/>',
  share: '<path d="M12 16V3m-4 4 4-4 4 4M6 11H4v10h16V11h-2"/>',
  play: '<path d="m8 5 12 7-12 7Z" fill="currentColor" stroke="none"/>',
};
---

<svg
  class:list={["icon", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={paths[name]}
/>
