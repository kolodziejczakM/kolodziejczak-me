---
import Seo from "../components/Seo.astro";
import type { Article } from "../lib/articles";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Icon from "../components/Icon.astro";
import BackgroundSurface from "../components/BackgroundSurface.astro";
import { site } from "../config/site";
import { text, otherLocale, type Locale } from "../lib/i18n";
import "../styles/site.css";
interface Props {
  locale: Locale;
  page: "home" | "blog" | "article";
  title: string;
  description: string;
  otherPath: string;
  article?: Article;
}
const { locale, page, title, description, otherPath, article } = Astro.props;
const translations = {
  [locale]: Astro.url.pathname,
  [otherLocale(locale)]: otherPath,
} as Record<Locale, string>;
const t = (pl: string, en: string) => text(locale, pl, en);
// Cloudflare Web Analytics publishes this site identifier in the page HTML.
const analyticsToken = "3c7893c3060241b7b62e8e72e7b5bd3f"; // gitleaks:allow
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      locale={locale}
      title={title}
      description={description}
      path={Astro.url.pathname}
      kind={page}
      translations={translations}
      article={article}
    />
    <meta name="theme-color" content="#0e241d" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/bricolage-grotesque.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    {page === "article" && (
      <link
        rel="preload"
        href="/fonts/ibm-plex-mono.ttf"
        as="font"
        type="font/ttf"
        crossorigin
      />
    )}
  </head>
  <body data-page={page}>
    <BackgroundSurface />
    <a class="skip-link" href="#main">
      {t("Przejdź do treści", "Skip to content")}
    </a>
    <Header locale={locale} page={page} otherPath={otherPath} />
    <slot />
    <Footer locale={locale} />
    <aside
      class="language-nudge"
      data-language-nudge
      data-other-locale={otherLocale(locale)}
      hidden
      aria-label={t("Sugestia języka", "Language suggestion")}
    >
      <span>{t("Prefer English?", "Wolisz po polsku?")}</span>
      <a href={otherPath} lang={otherLocale(locale)}>
        {t("Read in English ↗", "Czytaj po polsku ↗")}
      </a>
      <button
        type="button"
        data-dismiss-language
        aria-label={t("Zamknij", "Dismiss")}
      >
        <Icon name="close" />
      </button>
    </aside>
    <dialog id="article-dialog" aria-labelledby="dialog-title">
      <button
        class="dialog-close icon-button"
        type="button"
        aria-label={t("Zamknij", "Close")}
      >
        <Icon name="close" />
      </button>
      <span class="eyebrow">{t("WOKÓŁ ARTYKUŁU", "AROUND THE ARTICLE")}</span>
      <h2 id="dialog-title"></h2>
      <div data-dialog-body></div>
      <div
        class="sr-only"
        data-dialog-status
        data-action-status
        role="status"
        aria-live="polite"
        aria-atomic="true"
      ></div>
    </dialog>
    <div
      id="status"
      data-action-status
      class="sr-only"
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>
    <script>
      import "../scripts/site.ts";
    </script>
    {import.meta.env.PROD && site.readyToPublish && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </body>
</html>
